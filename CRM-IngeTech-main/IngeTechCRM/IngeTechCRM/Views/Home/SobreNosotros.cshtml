@{
    ViewData["Title"] = "Sobre Nosotros";
}

<!-- Banner principal -->
<div class="relative overflow-hidden bg-gradient-to-r from-brand-blue to-blue-500 py-16 md:py-20">
    <div class="absolute inset-0 z-10 bg-opacity-30 pattern-dots"></div>
    <div class="absolute bottom-0 left-0 right-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" class="text-white">
            <path fill="currentColor" fill-opacity="1" d="M0,224L60,229.3C120,235,240,245,360,224C480,203,600,149,720,144C840,139,960,181,1080,197.3C1200,213,1320,203,1380,197.3L1440,192L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path>
        </svg>
    </div>
    <div class="container relative z-20 mx-auto px-4 text-white">
        <div class="max-w-4xl">
            <h1 class="mb-4 text-[35px] font-bold md:text-5xl lg:text-6xl">
                Sobre <span class="font-light">IngeTech</span>
            </h1>
            <p class="mb-6 text-xl md:text-2xl">Más de una década transformando la tecnología en Costa Rica</p>
            <p class="mb-8 text-lg opacity-90">Conoce nuestra historia, misión y el equipo que hace posible brindar la mejor experiencia tecnológica.</p>
        </div>
    </div>
</div>

<!-- Nuestra Historia -->
<div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
            <h2 class="mb-6 text-[35px] font-bold text-gray-dark">Nuestra Historia</h2>
            <div class="space-y-6 text-lg text-gray-light">
                <p>
                    IngeTech nació en 2012 con una visión clara: democratizar el acceso a la tecnología en Costa Rica.
                    Fundada por un grupo de ingenieros apasionados por la innovación, comenzamos como una pequeña
                    tienda en San José con el sueño de conectar a las personas con las mejores herramientas tecnológicas.
                </p>
                <p>
                    Lo que comenzó como un proyecto familiar se ha convertido en una de las empresas líderes en
                    distribución de tecnología en el país. Hoy, más de 10 años después, servimos a más de 10,000
                    clientes en las 7 provincias de Costa Rica.
                </p>
                <p>
                    Nuestro crecimiento ha sido posible gracias a la confianza de nuestros clientes y al compromiso
                    inquebrantable de nuestro equipo por ofrecer productos de calidad y un servicio excepcional.
                </p>
            </div>
        </div>
        <div class="order-first lg:order-last">
            <div class="overflow-hidden rounded-2xl bg-gradient-to-br from-brand-blue/10 to-blue-500/10 p-8">
                <div class="grid grid-cols-2 gap-6">
                    <div class="text-center">
                        <div class="mb-3 text-4xl font-bold text-brand-blue">2012</div>
                        <div class="text-sm text-gray-light">Año de fundación</div>
                    </div>
                    <div class="text-center">
                        <div class="mb-3 text-4xl font-bold text-brand-blue">+10K</div>
                        <div class="text-sm text-gray-light">Clientes satisfechos</div>
                    </div>
                    <div class="text-center">
                        <div class="mb-3 text-4xl font-bold text-brand-blue">7</div>
                        <div class="text-sm text-gray-light">Provincias</div>
                    </div>
                    <div class="text-center">
                        <div class="mb-3 text-4xl font-bold text-brand-blue">50+</div>
                        <div class="text-sm text-gray-light">Colaboradores</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Misión, Visión y Valores -->
<div class="bg-gray-light/30 py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-2 text-[35px] font-bold text-gray-dark">Nuestros Pilares</h2>
            <p class="mx-auto max-w-2xl text-gray-light">Los valores y principios que guían cada decisión y acción en IngeTech.</p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            <!-- Misión -->
            <div class="overflow-hidden rounded-xl bg-white shadow-lg">
                <div class="bg-gradient-to-r from-brand-blue to-blue-500 p-6 text-white">
                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white bg-opacity-30 text-3xl">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3 class="text-2xl font-bold">Misión</h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-light">
                        Facilitar el acceso a la tecnología de vanguardia en Costa Rica, ofreciendo productos
                        de calidad, asesoría especializada y un servicio al cliente excepcional que supere
                        las expectativas de nuestros usuarios.
                    </p>
                </div>
            </div>

            <!-- Visión -->
            <div class="overflow-hidden rounded-xl bg-white shadow-lg">
                <div class="bg-gradient-to-r from-blue-500 to-brand-blue p-6 text-white">
                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white bg-opacity-30 text-3xl">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3 class="text-2xl font-bold">Visión</h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-light">
                        Ser la empresa líder en distribución de tecnología en Centroamérica, reconocida por
                        nuestra innovación, confiabilidad y compromiso con el desarrollo tecnológico de la región.
                    </p>
                </div>
            </div>

            <!-- Valores -->
            <div class="overflow-hidden rounded-xl bg-white shadow-lg">
                <div class="bg-gradient-to-r from-brand-blue to-blue-500 p-6 text-white">
                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white bg-opacity-30 text-3xl">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3 class="text-2xl font-bold">Valores</h3>
                </div>
                <div class="p-6">
                    <ul class="space-y-2 text-gray-light">
                        <li class="flex items-center"><i class="fas fa-check-circle mr-2 text-brand-blue"></i> Integridad</li>
                        <li class="flex items-center"><i class="fas fa-check-circle mr-2 text-brand-blue"></i> Innovación</li>
                        <li class="flex items-center"><i class="fas fa-check-circle mr-2 text-brand-blue"></i> Excelencia</li>
                        <li class="flex items-center"><i class="fas fa-check-circle mr-2 text-brand-blue"></i> Compromiso</li>
                        <li class="flex items-center"><i class="fas fa-check-circle mr-2 text-brand-blue"></i> Responsabilidad</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

