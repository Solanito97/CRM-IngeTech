<!-- Compromiso Social -->
<div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div class="order-last lg:order-first">
            <div class="overflow-hidden rounded-2xl bg-gradient-to-br from-brand-blue to-blue-500 p-8 text-white">
                <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-white bg-opacity-30 text-3xl">
                    <i class="fas fa-hands-helping"></i>
                </div>
                <h3 class="mb-4 text-2xl font-bold">Compromiso Social</h3>
                <div class="space-y-4">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1 text-white"></i>
                        <div>
                            <h4 class="font-semibold">Programa de Donaciones</h4>
                            <p class="text-sm opacity-90">Donamos equipos a escuelas rurales cada año</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1 text-white"></i>
                        <div>
                            <h4 class="font-semibold">Capacitación Gratuita</h4>
                            <p class="text-sm opacity-90">Talleres de tecnología para comunidades</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1 text-white"></i>
                        <div>
                            <h4 class="font-semibold">Reciclaje Tecnológico</h4>
                            <p class="text-sm opacity-90">Programa de reciclaje de equipos electrónicos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <h2 class="mb-6 text-[35px] font-bold text-gray-dark">Más que una empresa</h2>
            <div class="space-y-6 text-lg text-gray-light">
                <p>
                    En IngeTech creemos que el éxito va más allá de las ventas. Nuestro compromiso con Costa Rica
                    se refleja en los programas sociales que desarrollamos para cerrar la brecha digital y
                    promover la educación tecnológica.
                </p>
                <p>
                    Cada año destinamos el 5% de nuestras ganancias a programas de responsabilidad social,
                    apoyando a comunidades rurales, escuelas y organizaciones sin fines de lucro.
                </p>
                <div class="flex items-center gap-4">
                    <a href="@Url.Action("Contacto")" class="inline-flex items-center rounded-lg bg-brand-blue px-6 py-3 font-medium text-white shadow-lg transition duration-300 hover:bg-brand-blue/90">
                        <i class="fas fa-handshake mr-2"></i> Únete a nosotros
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action Final -->
<div class="relative overflow-hidden bg-gradient-to-r from-brand-blue to-blue-500 py-16">
    <div class="absolute inset-0 z-10 bg-opacity-20 pattern-dots"></div>
    <div class="container relative z-20 mx-auto px-4 text-center text-white">
        <h2 class="mb-6 text-[35px] font-bold md:text-4xl">¿Quieres formar parte de nuestro equipo?</h2>
        <p class="mx-auto mb-8 max-w-2xl text-lg">
            Siempre estamos buscando talento apasionado por la tecnología y el servicio al cliente excepcional.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="@Url.Action("Contacto")" class="inline-flex items-center rounded-lg bg-white px-6 py-3 font-medium text-brand-blue shadow-lg transition duration-300 hover:bg-brand-blue/10">
                <i class="fas fa-envelope mr-2"></i> Envía tu CV
            </a>
            <a href="@Url.Action("Catalogo")" class="inline-flex items-center rounded-lg border-2 border-white bg-transparent px-6 py-3 font-medium text-white transition duration-300 hover:bg-white hover:text-brand-blue">
                <i class="fas fa-shopping-cart mr-2"></i> Conoce nuestros productos
            </a>
        </div>
    </div>
</div>

