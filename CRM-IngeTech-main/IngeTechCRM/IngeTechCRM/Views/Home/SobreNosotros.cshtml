<!-- Nuestros Logros -->
<div class="bg-gray-light/30 py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-2 text-[35px] font-bold text-gray-dark">Nuestros Logros</h2>
            <p class="mx-auto max-w-2xl text-gray-light">Reconocimientos que reflejan nuestro compromiso con la excelencia.</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            <div class="overflow-hidden rounded-xl bg-white p-8 shadow-lg text-center">
